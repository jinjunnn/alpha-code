{
  "$id": "alpha-package-compatibility-report-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "findings": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9.-]{0,127}$",
            "type": "string"
          },
          "disposition": {
            "enum": [
              "mapped",
              "skipped",
              "review-required",
              "blocked"
            ]
          },
          "path": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "code",
          "disposition",
          "path"
        ],
        "type": "object"
      },
      "maxItems": 64,
      "minItems": 1,
      "type": "array"
    },
    "hostContract": {
      "additionalProperties": false,
      "properties": {
        "artifactPath": {
          "const": "packages/ui-mac/src/shared/host-extension-package-contract"
        },
        "artifactSha256": {
          "const": "485f1de9f56b866431f87ce4b7956b73fb65d650c3b8abddd7dd4279c91326ab"
        },
        "commit": {
          "const": "133f463d93664269db0cf91f1c1ff7d7887d6bf9"
        },
        "repo": {
          "const": "jinjunnn/alpha-code"
        }
      },
      "required": [
        "repo",
        "commit",
        "artifactPath",
        "artifactSha256"
      ],
      "type": "object"
    },
    "inputSha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "packageId": {
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9-]{0,31}:[a-z0-9][a-z0-9._-]{0,127}$",
      "type": "string"
    },
    "schema": {
      "const": "codepuppy.package-compatibility-report.v1"
    },
    "verdict": {
      "enum": [
        "compatible",
        "review-required",
        "blocked"
      ]
    },
    "version": {
      "maxLength": 64,
      "pattern": "^[0-9A-Za-z][0-9A-Za-z._-]{0,63}$",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "packageId",
    "version",
    "inputSha256",
    "hostContract",
    "verdict",
    "findings"
  ],
  "title": "AlphaPackageCompatibilityReportV1",
  "type": "object"
}
