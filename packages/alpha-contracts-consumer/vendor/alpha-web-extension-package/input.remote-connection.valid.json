{
  "packageId": "package:generic-remote-connection",
  "presentation": {
    "description": "Generic compiler corpus input with a host-owned Alpha Connection.",
    "displayName": "Generic Remote MCP (Alpha Connection)"
  },
  "root": {
    "component": {
      "behavior": {
        "auth": {
          "connectionHandlerId": "generic-handler",
          "kind": "alpha-connection",
          "prerequisiteId": "generic-connection",
          "required": false
        },
        "headersTemplate": {
          "X-Tenant": "{TENANT_ID}"
        },
        "requiredSecrets": [
          "TENANT_ID"
        ],
        "url": "https://connection.example.com/mcp"
      },
      "id": "mcp:generic-remote-connection",
      "kind": "mcp",
      "transport": "remote",
      "version": "1.0.0"
    }
  },
  "schema": "alpha.package-declaration.v1",
  "source": {
    "kind": "alpha-native",
    "publisher": "official",
    "redistributable": true
  },
  "version": "1.0.0"
}
