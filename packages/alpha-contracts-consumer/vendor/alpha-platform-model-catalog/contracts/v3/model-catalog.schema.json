{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "model-catalog.schema.json",
  "title": "ModelCatalogV3",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 3
    },
    "object": {
      "type": "string",
      "const": "list"
    },
    "data": {
      "maxItems": 512,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "object": {
            "type": "string",
            "const": "model"
          },
          "provider": {
            "type": "string",
            "enum": [
              "deepseek",
              "openai",
              "openrouter",
              "anthropic",
              "zhipu",
              "alibaba"
            ]
          },
          "min_plan": {
            "type": "string",
            "enum": [
              "free",
              "member"
            ]
          },
          "pricing_multiplier": {
            "type": "object",
            "properties": {
              "input": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "output": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "input",
              "output"
            ],
            "additionalProperties": false
          },
          "display": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "brand": {
                "type": "string",
                "enum": [
                  "anthropic",
                  "openai",
                  "deepseek",
                  "zhipu",
                  "qwen",
                  "moonshot",
                  "minimax"
                ]
              },
              "reasoning": {
                "type": "boolean"
              },
              "web": {
                "type": "boolean"
              },
              "variants": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32
                },
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "reasoningEffort": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 32
                    },
                    "reasoning": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {}
                    },
                    "thinking": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {}
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "name",
              "brand"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "object",
          "provider",
          "min_plan",
          "pricing_multiplier",
          "display"
        ],
        "additionalProperties": false
      }
    },
    "edition": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "pricing_basis_model_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  },
  "required": [
    "schema_version",
    "object",
    "data",
    "edition",
    "pricing_basis_model_id"
  ],
  "additionalProperties": false
}
