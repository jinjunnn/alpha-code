{
  "schema": "alpha.host-extension-package.registry.v1",
  "profiles": [
    {
      "profileId": "agent",
      "profileVersion": 1,
      "mediaType": "application/vnd.alpha.host-extension-package.agent.v1+json",
      "schemaPath": "profiles/agent.v1.schema.json"
    },
    {
      "profileId": "mcp-local",
      "profileVersion": 1,
      "mediaType": "application/vnd.alpha.host-extension-package.mcp-local.v1+json",
      "schemaPath": "profiles/mcp-local.v1.schema.json"
    },
    {
      "profileId": "mcp-remote",
      "profileVersion": 1,
      "mediaType": "application/vnd.alpha.host-extension-package.mcp-remote.v1+json",
      "schemaPath": "profiles/mcp-remote.v1.schema.json"
    },
    {
      "profileId": "skill",
      "profileVersion": 1,
      "mediaType": "application/vnd.alpha.host-extension-package.skill.v1+json",
      "schemaPath": "profiles/skill.v1.schema.json"
    }
  ],
  "capabilities": [
    {
      "token": "alpha.connection.v1",
      "semantic": "Complete a host-owned Alpha Connection handshake through a statically registered handler before the component is installed."
    },
    {
      "token": "alpha.mcp-oauth.v1",
      "semantic": "Complete an engine-owned MCP OAuth authorization before the component is installed; no token material ever appears in package bytes."
    },
    {
      "token": "alpha.secret-prerequisite.v1",
      "semantic": "Resolve declared secret references without placing secret values in package bytes."
    }
  ],
  "limits": {
    "maxEnvelopeBytes": 65536,
    "maxHeaderDepth": 6,
    "maxHeaderNodes": 512,
    "maxStringBytes": 4096,
    "maxCapabilities": 16,
    "maxComponentAssetFiles": 64,
    "maxComponents": 16,
    "maxMarkdownAssetBytes": 5242880,
    "maxPayloadBytes": 1048576,
    "maxPayloadDepth": 8,
    "maxPayloadNodes": 512
  }
}
