{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "profiles/mcp-local.v1.schema.json",
  "title": "HostExtensionPackage Local MCP Payload V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "behavior"
  ],
  "properties": {
    "schema": {
      "const": "alpha.host-extension-package.payload.mcp-local.v1"
    },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "environment",
        "requiredSecrets"
      ],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "environment": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "pattern": "^[A-Z_][A-Z0-9_]{0,127}$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 2048
          }
        },
        "requiredSecrets": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z_][A-Z0-9_]{0,127}$"
          }
        }
      }
    }
  }
}
