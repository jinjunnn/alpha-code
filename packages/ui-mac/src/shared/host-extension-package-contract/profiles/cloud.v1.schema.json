{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "profiles/cloud.v1.schema.json",
  "title": "HostExtensionPackage Cloud Capability Payload V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "behavior"
  ],
  "properties": {
    "schema": {
      "const": "codepuppy.host-extension-package.payload.cloud.v1"
    },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pipelineKind",
        "fields",
        "fixed",
        "holdUsd",
        "upstreamData"
      ],
      "properties": {
        "pipelineKind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "fields": {
          "type": "array",
          "minItems": 0,
          "maxItems": 16,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/textField"
              },
              {
                "$ref": "#/$defs/selectField"
              }
            ]
          }
        },
        "fixed": {
          "type": "array",
          "minItems": 0,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/fixedInput"
          }
        },
        "holdUsd": {
          "type": "number",
          "minimum": 0
        },
        "upstreamData": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    }
  },
  "$defs": {
    "inputName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "help": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "textField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "control",
        "required",
        "maxChars",
        "label"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/inputName"
        },
        "control": {
          "enum": [
            "text",
            "textarea"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "minChars": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "maxChars": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "help": {
          "$ref": "#/$defs/help"
        }
      }
    },
    "selectField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "control",
        "required",
        "options",
        "label"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/inputName"
        },
        "control": {
          "const": "select"
        },
        "required": {
          "type": "boolean"
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "default": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "help": {
          "$ref": "#/$defs/help"
        }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "label"
      ],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "label": {
          "$ref": "#/$defs/label"
        }
      }
    },
    "fixedInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/inputName"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    }
  }
}
