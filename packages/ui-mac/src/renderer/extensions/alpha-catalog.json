        "mcpType": "local",
        "command": ["npx", "-y", "@modelcontextprotocol/server-github@2025.4.8"],
        "requiredEnvVars": ["GITHUB_PERSONAL_ACCESS_TOKEN"],
        "runtimeDep": ["node"],
        "_verify": "GitHub 官方 MCP 已迁向 Go 二进制及 remote 端点;落地前确认用 npm 包还是 remote+OAuth。token 走 keychain 占位,不硬编码。"
