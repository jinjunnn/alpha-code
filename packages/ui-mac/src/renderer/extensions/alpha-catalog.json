      "category": "cloud",
      "installSpec": {
        "kind": "cloud",
        "pipelineKind": "code-review",
        "inputContract": [
          {
            "field": "input.diff",
            "description": "git diff 文本(diff-only;云侧另截断至 12k 字符)",
            "required": true
          }
        ],
        "budgetDefaults": {
          "max_iter": 25,
          "max_tokens": 300000,
          "max_wall_clock_sec": 600
        },
        "budgetLimits": {
          "max_iter": 50,
          "max_tokens": 500000,
          "max_wall_clock_sec": 1800
        },
        "tier": "Tier-1(云端流水线,无沙箱)",
        "upstreamData": [
          "git diff 文本(input.diff;1MB 信封帽,云侧另截 12k 字符)",
          "变更意图摘要与审查结论(云侧模型生成,存于任务产物)",
          "派发信封元数据(预算/约束;denied_paths 缺省注入)"
        ]
      },
      "version": "2026-07-06.1"
    },
