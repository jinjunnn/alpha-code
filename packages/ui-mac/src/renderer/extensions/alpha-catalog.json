{
  "version": "2026-07-03.1",
  "_note": "alpha-code 内置扩展目录(定制中心)。随渲染层 bundle、离线优先。schema 见 docs/designs/2026-06-22-arch-extension-hub.md(CatalogEntry / InstallSpec / bundleItems)。",
  "_disclaimers": [
    "标 _verify 的条目:包名/协议/可用性需落地前手工核实,不得当作已确认事实。",
    "redistributable=false 的条目不得把其文件内置进 app,只能运行时远程拉或引导用户自装。",
    "Anthropic document-skills(docx/xlsx/pptx/pdf)源码可见但禁止再分发,故本目录不收。",
    "MCP command/version 全部钉精确版本(A2/T1.5):npx `@pkg@x.y.z` / uvx `pkg@x.y.z`,消除每启动在线解析风暴。钉的值 = 更新当日各包 latest,行为与不钉一致、仅冻结确定性。升级 = 手动 bump(见 npm/pypi)。存量用户配置的一键钉版本迁移(T1.5 第二半)仍待做。",
    "内置 skill 资产(builtinAssetKey → resources/skills/):alpha-upstream-sync / safe-refactor(MIT,自写)+ skill-creator(Apache-2.0,Anthropic 官方,S12 T7 已打包,见 NOTICE)。mcp-builder / canvas-design / brand-guidelines 尚无可信来源打包 → 安装时诚实失败(非占位),待授权资产落地后补。"
  ],
  "entries": [
    {
      "id": "mcp:markitdown",
      "type": "mcp",
      "name": "markitdown",
      "displayName": "文档读取(markitdown)",
      "description": "把 PDF/Word/PPT/Excel/图片/HTML 转成 Markdown 供模型读取。Microsoft 官方。",
      "source": "official",
      "category": "office",
      "license": "MIT",
      "redistributable": true,
      "installSpec": {
        "kind": "mcp",
        "mcpType": "local",
        "command": ["uvx", "markitdown-mcp@0.0.1a4"],
        "requiredEnvVars": [],
        "runtimeDep": ["uv"]
      }
    },
    {
      "id": "mcp:filesystem",
      "type": "mcp",
      "name": "filesystem",
      "displayName": "文件系统",
      "description": "在白名单目录内读写本地文件。modelcontextprotocol 官方参考实现。",
      "source": "official",
      "category": "dev",
      "license": "MIT",
      "redistributable": true,
      "installSpec": {
        "kind": "mcp",
        "mcpType": "local",
        "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem@2026.1.14", "{workspace}"],
        "requiredEnvVars": [],
        "runtimeDep": ["node"],
        "_note": "{workspace} 安装时替换为当前项目目录;该路径即此 MCP 的可访问白名单。"
      }
    },
    {
      "id": "mcp:fetch",
      "type": "mcp",
      "name": "fetch",
      "displayName": "网页抓取(fetch)",
      "description": "抓取 URL 并转 Markdown,供研究/检索。官方参考实现。",
      "source": "official",
      "category": "research",
      "license": "MIT",
      "redistributable": true,
      "installSpec": {
        "kind": "mcp",
        "mcpType": "local",
        "command": ["uvx", "mcp-server-fetch@2026.6.4"],
        "requiredEnvVars": [],
        "runtimeDep": ["uv"]
      }
    },
    {
      "id": "mcp:playwright",
      "type": "mcp",
      "name": "playwright",
      "displayName": "浏览器自动化(Playwright)",
      "description": "让 agent 真正操作浏览器:打开网页、点击、填表单、截图、执行 JS——能读 webfetch 抓不动的 JS 动态站点。Microsoft 官方 MCP。",
      "source": "official",
      "category": "dev",
      "license": "Apache-2.0",
      "redistributable": true,
      "installSpec": {
        "kind": "mcp",
        "mcpType": "local",
        "command": ["npx", "-y", "@playwright/mcp@0.0.77"],
        "requiredEnvVars": [],
        "runtimeDep": ["node"],
        "_verify": "首次浏览时 Playwright 需浏览器内核:默认下载 Chromium(~150MB,中国区 egress 慢),或在 command 末尾加 \"--browser\",\"chrome\" 复用系统已装 Chrome(免下载但需已装)。runtimeDep 只能 which 到 node,内核下载发生在运行时而非安装时 → A6 必须桌面实测首个 navigate 能否真起浏览器。"
      }
    },
    {
      "id": "mcp:git",
      "type": "mcp",
      "name": "git",
      "displayName": "Git 操作",
      "description": "在仓库内执行 git 读写(status/log/diff/commit 等)。官方参考实现。",
