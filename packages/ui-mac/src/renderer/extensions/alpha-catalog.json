      "license": "MIT",
      "redistributable": true,
      "installSpec": {
        "kind": "mcp",
        "mcpType": "local",
        "command": ["uvx", "mcp-server-git@2026.6.16", "--repository", "{workspace}"],
        "requiredEnvVars": [],
        "runtimeDep": ["uv", "git"]
      }
    },
